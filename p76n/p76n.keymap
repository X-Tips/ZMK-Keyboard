#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    macros {
        xtips: xtips {
            compatible = "zmk,behavior-macro";
            label = "XTIPS";
            #binding-cells = <0>;
            bindings = <&kp LS(X) &kp KP_DOT &kp LS(T) &kp I &kp P &kp S>;
            wait-ms = <1>;
            tap-ms = <1>;
        };
    };

    keymap0: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12                         &kp KP_N7       &kp KP_N8       &kp KP_N9
            &kp ESC         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp BSPC                        &kp KP_N4       &kp KP_N5       &kp KP_N6
            &kp TAB         &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp ENTER                       &kp KP_N1       &kp KP_N2       &kp KP_N3
            &kp CAPS        &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp UP          &kp DEL                         &kp KP_PLUS     &kp KP_N0       &kp KP_DOT
            &kp LWIN        &kp LALT        &kp LCTRL       &kp LSHFT       &mo 1           &kp SPACE       &kp SPACE       &mo 1           &kp SLASH       &kp LEFT        &kp DOWN        &kp RIGHT       &mo 1           &kp KP_MINUS    &kp KP_MULTIPLY &kp KP_DIVIDE
            >;
        };

        fn1_layer {
            bindings = <
            &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR        &kp UNDER       &kp PLUS                        &out OUT_BLE    &bt BT_SEL 4    &bt BT_SEL 1
            &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL                       &bt BT_CLR_ALL  &bt BT_SEL 3    &bt BT_SEL 0
            &kp KP_NLCK     &kp SLCK        &kp PAUSE_BREAK &kp TILDE       &kp GRAVE       &kp DQT         &kp SQT         &kp PIPE        &kp BSLH        &none           &none           &none                           &out OUT_USB    &bt BT_CLR      &bt BT_SEL 2
            &kp INS         &kp PSCRN       &kp K_CMENU     &none           &kp LBKT        &kp RBKT        &kp LBRC        &kp RBRC        &none           &none           &kp PG_UP       &none                           &kp C_MUTE      &kp C_PREV      &kp C_VOL_UP
            &kp LWIN        &kp LALT        &kp LCTRL       &kp LSHFT       &none           &kp SPACE       &kp SPACE       &none           &none           &kp HOME        &kp PG_DN       &kp END         &xtips          &kp C_PP        &kp C_NEXT      &kp C_VOL_DN
            >;
        };

        fn2_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &bootloader     &none           &none           &none           &none           &none
            >;
        };

        fn3_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &bootloader     &none           &none           &none           &none           &none
            >;
        };

        fn4_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;
        };

        fn5_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;
        };

        fn6_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;
        };

        fn7_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;
        };

        fn8_layer {
            bindings = <
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none                           &none           &none           &none
            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;
